# panes/split.test
# Pane split: create a split pane and verify layout.

vu-cli --json panes list --tab 1  # start with 1 pane
---- json-subset
{"panes":[{"index":1}]}

vu-cli --json panes create --tab 1 --location right  # split right
---- ok

vu-cli --json panes list --tab 1  # now have 2 panes
---- contains
"index":2

vu-cli --json panes wait --tab 1 --pane-index 2 --timeout 15  # wait for new pane to become alive
---- ok

vu-cli --json panes list --tab 1  # both panes are alive
---- json-subset
{"panes":[{"is_alive":true},{"is_alive":true}]}
